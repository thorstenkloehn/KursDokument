@model List<LmsApp.Models.Lesson>
@{
    ViewData["Title"] = "Kurs Übersicht";

    string GetLevelName(int level) => level switch { 1 => "Leicht", 2 => "Mittel", 3 => "Schwer", _ => "Unbekannt" };
    string GetLevelColor(int level) => level switch { 1 => "success", 2 => "warning", 3 => "danger", _ => "secondary" };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">Kurs Übersicht</h1>
            <p class="text-muted small mb-0">Deine Lernfortschritte werden lokal gespeichert.</p>
        </div>
        <div>
            <button id="resetProgressBtn" class="btn btn-sm btn-outline-danger me-2">
                <i class="bi bi-trash"></i> Fortschritt löschen
            </button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> Zur Startseite
            </a>
        </div>
    </div>

    @foreach (var levelGroup in Model.GroupBy(l => l.Level).OrderBy(g => g.Key))
    {
        <div class="mb-5">
            <h2 class="h3 border-bottom pb-2 mb-4">
                <span class="badge bg-@GetLevelColor(levelGroup.Key)">@GetLevelName(levelGroup.Key)</span> 
                Modul-Übersicht
            </h2>
            
            @foreach (var courseGroup in levelGroup.GroupBy(l => l.Course))
            {
                <div class="ms-3 mb-4">
                    <h3 class="h5 text-secondary mb-3">Kurs: @courseGroup.Key</h3>
                    <div class="row">
                        @foreach (var lesson in courseGroup)
                        {
                            var isCompleted = Context.Request.Cookies.ContainsKey("lms_done_" + lesson.Id);
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 shadow-sm border-@(isCompleted ? "success" : GetLevelColor(lesson.Level)) @(isCompleted ? "bg-light bg-opacity-50" : "")">
                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="card-title mb-0 @(isCompleted ? "text-success" : "")">
                                                @if (isCompleted) { <i class="bi bi-check-circle-fill me-1"></i> }
                                                @lesson.Title
                                            </h5>
                                            <span class="badge rounded-pill bg-@GetLevelColor(lesson.Level) small">
                                                @GetLevelName(lesson.Level)
                                            </span>
                                        </div>
                                        <p class="card-text text-muted small mb-3">@lesson.Category</p>
                                        <div class="mt-auto">
                                            <a asp-action="Details" asp-route-id="@lesson.Id" class="btn @(isCompleted ? "btn-success" : "btn-outline-primary") w-100">
                                                @(isCompleted ? "Wiederholen" : "Lektion starten")
                                            </a>
                                        </div>
                                    </div>
                                    @if (isCompleted) {
                                        <div class="card-footer py-1 px-2 text-center bg-success text-white small" style="font-size: 0.75rem;">
                                            Abgeschlossen
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('resetProgressBtn').addEventListener('click', function() {
            if (confirm("Möchtest du deinen gesamten Fortschritt wirklich löschen? Alle abgeschlossenen Markierungen gehen verloren.")) {
                // Alle Cookies löschen, die mit 'lms_done_' beginnen
                const cookies = document.cookie.split(";");
                for (let i = 0; i < cookies.length; i++) {
                    const cookie = cookies[i].trim();
                    if (cookie.startsWith("lms_done_")) {
                        const eqPos = cookie.indexOf("=");
                        const name = eqPos > -1 ? cookie.substr(0, eqPos) : cookie;
                        document.cookie = name + "=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
                    }
                }
                location.reload(); // Seite neu laden, um Änderungen zu sehen
            }
        });
    </script>
}

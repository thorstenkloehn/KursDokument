@model LmsApp.Models.Lesson
@using Markdig
@{
    ViewData["Title"] = Model.Title;
    var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Kurse</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        @{
            var showEditor = Model.Course != "PraxisProjekte" && !string.IsNullOrEmpty(Model.CodeExample);
            var contentClass = showEditor ? "col-md-7" : "col-md-12";
        }
        <div class="@contentClass">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h1 class="card-title h3 text-primary">@Model.Title</h1>
                    <span class="badge bg-secondary mb-3">@Model.Category</span>
                    <hr />
                    <div class="lesson-content">
                        @Html.Raw(Markdown.ToHtml(Model.Content, pipeline))
                    </div>
                </div>
            </div>
            
            @if (!showEditor)
            {
                <div id="praxis-success-panel" class="d-none alert alert-success mt-4 animate__animated animate__fadeInUp">
                     <h4 class="alert-heading fw-bold"><i class="bi bi-check-circle-fill"></i> Projekt abgeschlossen!</h4>
                     <p class="mb-0">Hervorragend! Du hast dieses Praxis-Projekt eigenständig gelöst.</p>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Zurück zur Übersicht
                    </a>
                    
                    <button id="completeProjectBtn" class="btn btn-success btn-lg px-4 shadow-sm">
                        <i class="bi bi-patch-check"></i> Ich habe das Projekt gelöst!
                    </button>

                    @if (ViewBag.NextLessonId != null)
                    {
                        <a asp-action="Details" asp-route-id="@ViewBag.NextLessonId" class="btn btn-primary">
                            Nächste Lektion <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </div>
            }
        </div>

        @if (showEditor)
        {
            <div class="col-md-5">
                <div class="sticky-top" style="top: 20px;">
                    <!-- ... Editor Card ... -->
                    <div class="card shadow-sm">
                        <!-- Card Header etc. (stays the same) -->
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Übung: Code vervollständigen</span>
                            <div>
                                <button id="solutionBtn" class="btn btn-sm btn-outline-info me-2">Lösung anzeigen</button>
                                <button id="resetCodeBtn" class="btn btn-sm btn-outline-warning me-2">Code zurücksetzen</button>
                                <button id="verifyBtn" class="btn btn-sm btn-success">Überprüfen</button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div id="monaco-editor" style="height: 400px; border: 1px solid #ccc;"></div>
                        </div>
                        <div class="card-footer bg-light p-3">
                            <div id="result-message" class="alert d-none mt-2" role="alert"></div>
                            
                            <!-- Erfolgs-Konsole nach Abschluss (Anki Style) -->
                            <div id="success-panel" class="d-none text-center py-3 border rounded bg-white shadow-sm mt-3 animate__animated animate__fadeIn">
                                <h4 class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Lektion Abgeschlossen!</h4>
                                <p class="text-muted mb-3">Wann möchtest du diese Aufgabe wiederholen?</p>
                                
                                <div class="d-grid gap-2 col-10 mx-auto mb-4">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="setAnkiReview(0)">Nochmal<br/><small>&lt; 1 Min</small></button>
                                        <button type="button" class="btn btn-outline-warning btn-sm" onclick="setAnkiReview(1)">Schwer<br/><small>1 Tag</small></button>
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="setAnkiReview(4)">Gut<br/><small>4 Tage</small></button>
                                        <button type="button" class="btn btn-outline-success btn-sm" onclick="setAnkiReview(7)">Einfach<br/><small>7 Tage</small></button>
                                    </div>
                                </div>

                                <div class="d-grid gap-2 col-10 mx-auto">
                                    @if (ViewBag.NextLessonId != null)
                                    {
                                        <a asp-action="Details" asp-route-id="@ViewBag.NextLessonId" class="btn btn-success btn-lg">
                                            Nächste Übung <i class="bi bi-arrow-right"></i>
                                        </a>
                                    }
                                    <a asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-list-ul"></i> Zur Übersicht
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Gemini Chat Widget -->
                    <div class="card shadow-sm mt-3 border-primary">
                        <div class="card-header bg-primary text-white d-flex align-items-center">
                            <i class="bi bi-stars me-2"></i>
                            <span class="fw-bold">Gemini CLI Tutor</span>
                        </div>
                        <div class="card-body p-0">
                            <div id="chat-messages" style="height: 200px; overflow-y: auto; padding: 10px; background-color: #f8f9fa;">
                                <div class="chat-message-ai mb-2">
                                    <small class="text-muted">Gemini CLI Tutor:</small>
                                    <div class="bg-white p-2 border rounded shadow-sm">
                                        Hallo! Ich bin dein KI-Assistent. Wie kann ich dir bei dieser Aufgabe helfen?
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer p-2">
                            <div class="input-group">
                                <input type="text" id="chat-input" class="form-control" placeholder="Stelle eine Frage..." />
                                <button class="btn btn-primary" type="button" id="send-chat">
                                    <i class="bi bi-send"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (showEditor)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
        
        <!-- Vorbereitung für LSP (Language Server Protocol) via WebSockets -->
        <script type="module">
            // ... (rest of the script is updated below) ...
            require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });

            let editor;
            const expectedPlaceholders = @Json.Serialize(Model.Placeholders);
            const initialCode = @Json.Serialize(Model.CodeExample);
            const solutionCode = @Json.Serialize(Model.SolutionCode);
            const languageId = '@Model.Language';

            /**
             * Funktion zur Verbindung mit einem LSP-Proxy via WebSocket
             */
            function connectToLanguageServer(lang) {
                const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
                // Der LSP-Proxy läuft auf Port 3000
                const socketUrl = `${protocol}://${window.location.hostname}:3000/lsp?lang=${lang}`;
                
                console.log(`Verbinde zu Sprachserver für ${lang} unter ${socketUrl}...`);
                
                try {
                    const socket = new WebSocket(socketUrl);

                    socket.onopen = () => {
                        console.log("WebSocket Verbindung zum LSP-Proxy steht.");
                    };

                    socket.onerror = (err) => {
                        console.error("LSP WebSocket Fehler:", err);
                    };
                    
                    socket.onclose = () => {
                        console.warn("LSP WebSocket Verbindung geschlossen.");
                    };

                } catch (e) {
                    console.error("Fehler beim Starten der LSP-Verbindung:", e);
                }
            }

            require(['vs/editor/editor.main'], function () {
                editor = monaco.editor.create(document.getElementById('monaco-editor'), {
                    value: initialCode,
                    language: languageId,
                    theme: 'vs-dark',
                    fontSize: 14,
                    automaticLayout: true,
                    minimap: { enabled: false },
                    // IntelliSense Optionen für VS Code Feeling
                    suggestOnTriggerCharacters: true,
                    acceptSuggestionOnEnter: "on",
                    tabCompletion: "on",
                    wordBasedSuggestions: "off" // Wir wollen echte LSP Vorschläge, keine Textbasierten
                });

                // Check if already completed
                const cookieName = "lms_done_" + "@Model.Id";
                if (document.cookie.split(';').some((item) => item.trim().startsWith(cookieName + '='))) {
                    document.getElementById('success-panel').classList.remove('d-none');
                    document.getElementById('verifyBtn').disabled = true;
                    document.getElementById('solutionBtn').classList.add('d-none');
                }

                // Start der LSP-Verbindung
                connectToLanguageServer(languageId);
            });

            document.getElementById('solutionBtn').addEventListener('click', function() {
                if (confirm("Möchtest du die Lösung wirklich anzeigen? Dein aktueller Code wird überschrieben.")) {
                    editor.setValue(solutionCode);
                }
            });

            document.getElementById('resetCodeBtn').addEventListener('click', function() {
                if (confirm("Möchtest du diese Übung wirklich zurücksetzen? Dein Fortschritt für diese Lektion geht verloren.")) {
                    const cookieName = "lms_done_" + "@Model.Id";
                    document.cookie = cookieName + "=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
                    editor.setValue(initialCode);
                    
                    document.getElementById('success-panel').classList.add('d-none');
                    document.getElementById('verifyBtn').disabled = false;
                    document.getElementById('solutionBtn').classList.remove('d-none');
                    document.getElementById('result-message').classList.add('d-none');
                }
            });

            function setAnkiReview(days) {
                const now = new Date();
                const nextDate = new Date();
                nextDate.setDate(now.getDate() + days);
                if (days === 0) nextDate.setMinutes(now.getMinutes() + 1); // "Again" = 1 minute
                
                const reviewCookie = "lms_review_" + "@Model.Id";
                document.cookie = reviewCookie + "=" + nextDate.getTime() + "; path=/; max-age=" + (365 * 24 * 60 * 60);
                
                const doneCookie = "lms_done_" + "@Model.Id";
                document.cookie = doneCookie + "=true; path=/; max-age=" + (365 * 24 * 60 * 60);

                const btns = document.querySelectorAll('.btn-group button');
                btns.forEach(b => b.classList.add('disabled'));
                
                alert(`Geplant für die nächste Wiederholung: ${nextDate.toLocaleString()}`);
            }

            document.getElementById('verifyBtn').addEventListener('click', async function() {
                const currentCode = editor.getValue();
                const resultDiv = document.getElementById('result-message');
                const successPanel = document.getElementById('success-panel');
                
                const requestBody = {
                    code: currentCode,
                    expectedValues: expectedPlaceholders.map(p => p.expectedValue)
                };

                try {
                    const response = await fetch('/api/verification/check', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(requestBody)
                    });

                    const data = await response.json();

                    if (data.success) {
                        const cookieName = "lms_done_" + "@Model.Id";
                        document.cookie = cookieName + "=true; path=/; max-age=" + (30 * 24 * 60 * 60);

                        resultDiv.className = "alert alert-success mt-2 d-none";
                        successPanel.classList.remove('d-none');
                        successPanel.classList.add('animate__fadeInUp');
                        
                        confetti({
                            particleCount: 150,
                            spread: 70,
                            origin: { y: 0.6 }
                        });
                        
                        document.getElementById('verifyBtn').disabled = true;
                        document.getElementById('solutionBtn').classList.add('d-none');
                    } else {
                        resultDiv.className = "alert alert-danger mt-2 animate__animated animate__shakeX";
                        resultDiv.textContent = data.message;
                        resultDiv.classList.remove('d-none');
                    }
                } catch (error) {
                    resultDiv.className = "alert alert-warning mt-2";
                    resultDiv.textContent = "Fehler bei der lokalen Prüfung.";
                    resultDiv.classList.remove('d-none');
                }
            });

            // Chat Functionality
            const chatMessages = document.getElementById('chat-messages');
            const chatInput = document.getElementById('chat-input');
            const chatSendBtn = document.getElementById('send-chat');

            function addMessage(text, isUser = false) {
                const msgDiv = document.createElement('div');
                msgDiv.className = `chat-message-${isUser ? 'user' : 'ai'} mb-2`;
                
                const label = document.createElement('small');
                label.className = 'text-muted';
                label.textContent = isUser ? 'Du:' : 'Gemini CLI Tutor:';
                
                const content = document.createElement('div');
                content.className = `${isUser ? 'bg-primary text-white' : 'bg-white'} p-2 border rounded shadow-sm`;
                content.textContent = text;
                
                msgDiv.appendChild(label);
                msgDiv.appendChild(content);
                chatMessages.appendChild(msgDiv);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            async function sendMessage() {
                const msg = chatInput.value.trim();
                if (!msg) return;

                addMessage(msg, true);
                chatInput.value = '';

                try {
                    const response = await fetch('/api/chat/ask', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            message: msg,
                            lessonTitle: @Json.Serialize(Model.Title),
                            lessonContent: @Json.Serialize(Model.Content),
                            currentCode: editor.getValue()
                        })
                    });

                    const data = await response.json();
                    addMessage(data.response);
                } catch (error) {
                    addMessage("Fehler beim Abrufen der Antwort. Bitte versuche es später erneut.");
                }
            }

            chatSendBtn.addEventListener('click', sendMessage);
            chatInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') sendMessage();
            });
        </script>
    }
    else
    {
        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
        <script>
            const cookieName = "lms_done_" + "@Model.Id";
            const completeBtn = document.getElementById('completeProjectBtn');
            const successPanel = document.getElementById('praxis-success-panel');

            if (document.cookie.split(';').some((item) => item.trim().startsWith(cookieName + '='))) {
                completeBtn.disabled = true;
                completeBtn.innerHTML = '<i class="bi bi-check-all"></i> Projekt bereits gelöst';
                completeBtn.classList.replace('btn-success', 'btn-outline-success');
                successPanel.classList.remove('d-none');
            }

            completeBtn.addEventListener('click', function() {
                document.cookie = cookieName + "=true; path=/; max-age=" + (30 * 24 * 60 * 60);
                this.disabled = true;
                this.innerHTML = '<i class="bi bi-check-all"></i> Projekt bereits gelöst';
                this.classList.replace('btn-success', 'btn-outline-success');
                successPanel.classList.remove('d-none');
                
                confetti({
                    particleCount: 150,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            });
        </script>
    }
}
